{
  "name": "mistpine.obsidian",
  "private": true,
  "version": "0.0.0",
  "description": "Tooling for mistpine.obsidian: generates theme.css from the mistpine spec and renders the README images.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "check": "node scripts/generate.ts --check",
    "banner": "node scripts/banner.ts",
    "render": "node scripts/render.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "harfbuzzjs": "^1.6.4",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
